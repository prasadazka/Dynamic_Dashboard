# Adaptive Data Intelligence Platform — environment variables
#
# Local dev:
#   cp .env.example .env  and fill in real values
#
# GCP Cloud Run:
#   GROQ_API_KEY  -> stored in Secret Manager, mounted via --update-secrets
#   GROQ_MODEL / DEBUG / LOG_LEVEL -> set via --set-env-vars on `gcloud run deploy`

# --- Secrets (NEVER commit real values) ----------------------------------

# Groq API key. Get one at https://console.groq.com/keys
# In Cloud Run this comes from Secret Manager (see deployment docs).
GROQ_API_KEY=your_groq_api_key_here

# --- Non-secret configuration --------------------------------------------

# Model to use. Tested options:
#   llama-3.3-70b-versatile   (recommended for quality)
#   llama-3.1-8b-instant      (faster, cheaper)
#   llama3-70b-8192
#   llama3-8b-8192
#   mixtral-8x7b-32768
#   gemma-7b-it
GROQ_MODEL=llama-3.3-70b-versatile

# Set False in production
DEBUG=False

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
